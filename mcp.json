{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "notebook": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "-p",
        "git+https://github.com/gemini-cli-extensions/data-agent-kit-starter-pack.git",
        "notebook-tools",
        "--mode=notebook"
      ]
    },
    "visualization": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "-p",
        "git+https://github.com/gemini-cli-extensions/data-agent-kit-starter-pack.git",
        "notebook-tools",
        "--mode=visualization"
      ]
    },
    "bigquery": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/mcp/bin/mcp_proxy_bundle.cjs",
        "https://bigquery.googleapis.com/mcp"
      ],
      "env": {
        "X_GOOG_PROXY_HEADERS": "{\"User-Agent\": \"datacloud.other\"}"
      }
    },
    "spanner": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/mcp/bin/mcp_proxy_bundle.cjs",
        "https://spanner.googleapis.com/mcp"
      ],
      "env": {
        "X_GOOG_PROXY_HEADERS": "{\"User-Agent\": \"datacloud.other\"}"
      }
    },
    "alloydb-postgres": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/mcp/bin/mcp_proxy_bundle.cjs",
        "https://alloydb.googleapis.com/mcp"
      ],
      "env": {
        "X_GOOG_PROXY_HEADERS": "{\"User-Agent\": \"datacloud.other\"}"
      }
    },
    "cloud-sql-postgresql": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/mcp/bin/mcp_proxy_bundle.cjs",
        "https://sqladmin.googleapis.com/mcp"
      ],
      "env": {
        "X_GOOG_PROXY_HEADERS": "{\"User-Agent\": \"datacloud.other\"}"
      }
    },
    "knowledge_catalog": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/mcp/bin/mcp_proxy_bundle.cjs",
        "https://dataplex.googleapis.com/mcp"
      ],
      "env": {
        "X_GOOG_PROXY_HEADERS": "{\"User-Agent\": \"datacloud.other\"}"
      }
    },
    "dataproc": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/mcp/bin/mcp_proxy_bundle.cjs",
        "https://dataproc-$GCP_REGION.googleapis.com/mcp"
      ],
      "env": {
        "X_GOOG_PROXY_HEADERS": "{\"User-Agent\": \"datacloud.other\"}"
      }
    },
    "bigtable": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/mcp/bin/mcp_proxy_bundle.cjs",
        "https://bigtableadmin.googleapis.com/mcp"
      ],
      "env": {
        "X_GOOG_PROXY_HEADERS": "{\"User-Agent\": \"datacloud.other\"}"
      }
    },
    "cloud-storage": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/mcp/bin/mcp_proxy_bundle.cjs",
        "https://storage.googleapis.com/storage/mcp"
      ],
      "env": {
        "X_GOOG_PROXY_HEADERS": "{\"User-Agent\": \"datacloud.other\"}"
      }
    }
  }
}
